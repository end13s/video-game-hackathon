ELEVENLABS_API_KEY=
# Fallback voice for anything in content.js without its own voiceId
ELEVENLABS_TEST_VOICE_ID=
# eleven_v4_turbo acts out [audio tags]; eleven_flash_v2_5 is faster but reads tags aloud
ELEVENLABS_MODEL_ID=eleven_v4_turbo
PORT=3000
# The cloudflared tunnel URL, so the QR code works even with the TV open on localhost
PUBLIC_URL=
# Rounds per game. Leave empty for one per player; 1 for a quick demo
ROUNDS=
